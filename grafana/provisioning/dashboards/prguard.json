{
  "title": "PRGuard Pipeline Latency",
  "uid": "prguard-latency",
  "schemaVersion": 39,
  "timezone": "browser",
  "time": { "from": "now-6h", "to": "now" },
  "refresh": "30s",
  "panels": [
    {
      "id": 1,
      "title": "Stage latency (p50 / p95 / p99)",
      "type": "timeseries",
      "gridPos": { "h": 9, "w": 24, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        {
          "expr": "histogram_quantile(0.5, sum(rate(pr_stage_duration_seconds_bucket[5m])) by (le, service, stage))",
          "legendFormat": "{{service}}/{{stage}} p50"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(pr_stage_duration_seconds_bucket[5m])) by (le, service, stage))",
          "legendFormat": "{{service}}/{{stage}} p95"
        },
        {
          "expr": "histogram_quantile(0.99, sum(rate(pr_stage_duration_seconds_bucket[5m])) by (le, service, stage))",
          "legendFormat": "{{service}}/{{stage}} p99"
        }
      ]
    },
    {
      "id": 2,
      "title": "Stage error count (last 1h)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 9 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "targets": [
        {
          "expr": "sum(increase(pr_stage_total{outcome=\"error\"}[1h])) by (service, stage)",
          "legendFormat": "{{service}}/{{stage}}"
        }
      ]
    },
    {
      "id": 3,
      "title": "DLQ messages (last 1h)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 9 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "targets": [
        {
          "expr": "sum(increase(dlq_messages_total[1h])) by (error_type)",
          "legendFormat": "{{error_type}}"
        }
      ]
    }
  ]
}
