global:
  smtp_from: '__GMAIL_USER__'
  smtp_smarthost: 'smtp.gmail.com:587'
  smtp_auth_username: '__GMAIL_USER__'
  smtp_auth_password: '__GMAIL_APP_PASSWORD__'
  smtp_require_tls: true

route:
  receiver: email
  group_by: ['alertname', 'service']
  group_wait: 30s
  group_interval: 5m
  repeat_interval: 4h

receivers:
  - name: email
    email_configs:
      - to: '__NOTIFY_EMAIL__'
        send_resolved: true
